x-node-base: &node-base
  build:
    context: .
    target: runtime
  restart: unless-stopped
  networks:
    - quench-net

services:

  # ─── Среда разработки ──────────────────────────────────────────────────────
  dev:
    build:
      context: .
      target: dev
    container_name: quench-dev
    volumes:
      # Монтируем весь проект внутрь — изменения сразу видны
