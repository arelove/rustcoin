      --p2p-port 8334
      --rpc-port 8546
      --peer /ip4/node1/tcp/8333
    ports:
      - "8334:8334"
      - "8546:8546"
    volumes:
      - node2-data:/data
    environment:
      - RUST_LOG=quench=info,libp2p=warn
