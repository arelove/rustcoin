    pub threads: usize,
}
/// Logging configuration.
#[derive(Debug, Clone, Serialize, Deserialize)]
pub struct LogConfig {
    /// Log level: `"trace"`, `"debug"`, `"info"`, `"warn"`, or `"error"`.
    pub level: String,
    /// Log format: `"pretty"`, `"json"`, or `"compact"`.
    pub format: String,
}

