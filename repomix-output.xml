      --p2p-port 8335
      --rpc-port 8547
      --peer /ip4/node1/tcp/8333
    ports:
      - "8335:8335"
      - "8547:8547"
    volumes:
      - node3-data:/data
    environment:
      - RUST_LOG=quench=info,libp2p=warn
    depends_on:
      - node1

# ─── Тома для хранения данных ──────────────────────────────────────────────
